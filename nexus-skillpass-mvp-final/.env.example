# =============================================================================
# SkillPass by AINDEV NEXUS — environment variables
# Copy to .env.local for local development. Never commit real values.
# =============================================================================

# Public origin used for share links, QR codes and auth redirects.
# Local: http://127.0.0.1:3000   Production: https://skillpass.aindev.com.mx
NEXT_PUBLIC_APP_URL=

# --- Supabase (required for real accounts and persistence) -------------------
# Project URL and the PUBLIC anon/publishable key. The app never needs the
# service-role key at runtime; RLS + RPC authorization run with the user's JWT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer key format (used instead of the anon key when set).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Demo mode ---------------------------------------------------------------
# local    : isolated embedded PostgreSQL (PGlite) per visitor, on local disk.
#            Default for `npm run dev` / `npm start` on your machine. Not for Vercel.
# supabase : one-click demo personas backed by a SEPARATE Supabase demo project
#            (accounts created by `npm run seed -- --supabase`).
# off      : /demo explains the product but does not sign anyone in.
# Default: local when not running on Vercel, otherwise off.
NEXUS_DEMO_MODE=
# Signing key for local demo cookies (>= 32 random chars). If empty, a random
# key is generated in .demo-data/.session-key (local only).
NEXUS_DEMO_SECRET=
# Local demo storage directory (persistent local disk, not a network share).
NEXUS_DEMO_DATA_DIR=.demo-data
# Hours an isolated local demo scenario is kept before automatic cleanup.
NEXUS_DEMO_TTL_HOURS=48
# Maximum concurrent local demo scenarios on disk.
NEXUS_DEMO_MAX_SESSIONS=50
# Password of the fictional demo accounts in the Supabase DEMO project
# (only for NEXUS_DEMO_MODE=supabase). Use a long random value; demo data only.
NEXUS_DEMO_PASSWORD=
# Where the public demo lives (https origin). Only used when NEXUS_DEMO_MODE=off:
# /demo then redirects there, e.g. https://demo.skillpass.aindev.com.mx
DEMO_URL=

# --- Shared attempt limits (migration 20261104000001) -------------------------
# >= 32 random chars (e.g. `openssl rand -hex 32`). Signs the counter keys and
# unlocks sp_rate_limit once `node scripts/rate-limit-gate.mjs` has stored its gate
# in the database. Empty: per-instance limits (fine locally and for the demo).
RATE_LIMIT_SECRET=

# --- Antivirus (scanner/, migration 20261105000001) ----------------------------
# URL of the ClamAV scanner (https) and the token it shares with the app (>= 32
# chars). With both set every upload is scanned before it is stored and infected
# files are refused. Empty: files are stored unscanned (fine locally and for the
# demo; production turns on scan_required with `node scripts/scan-gate.mjs`).
SCANNER_URL=
SCANNER_TOKEN=

# --- Uploads -----------------------------------------------------------------
# Max evidence upload in MB (keep <= 4 on Vercel: 4.5 MB function body limit).
MAX_UPLOAD_MB=4

# --- Seeding a Supabase DEMO project (operator machine only, never in Vercel) --
# Used exclusively by `npm run seed -- --supabase`. Do not set in the app runtime.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
