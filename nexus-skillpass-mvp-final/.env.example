# Optional for local DEMO; required for real Supabase auth and persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Or the newer publishable key; do not put a service role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Leave blank for local origin; set to your HTTPS deployment origin in production.
NEXT_PUBLIC_APP_URL=
# Local PGlite demo only: separate database per visitor. Disable on serverless.
NEXUS_DEMO_ENABLED=true
# Required to enable DEMO with NODE_ENV=production (minimum 32 random characters).
NEXUS_DEMO_SECRET=
# Local persistent disk, not a shared/network filesystem.
NEXUS_DEMO_DATA_DIR=.demo-data
# Optional destructive-free demo capacity guard.
NEXUS_DEMO_MAX_SESSIONS=30
